# Copy to .env and fill in. `.env` is git-ignored; this file is not, so nothing
# real belongs here.
#
#   cp .env.example .env
#
# Generate the two long secrets rather than inventing them:
#
#   openssl rand -base64 48
#
# On Windows without openssl:
#
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#
# `docker compose up` fails immediately, naming the variable, if any of the three
# below is missing. That is deliberate — a stack that starts with a blank signing
# key is worse than one that does not start.


# --- mail (optional, and the product cannot invite anybody without it) -----

# Sending is off by default, because this stack has no mail relay in it. Leave
# these empty for a demo; fill them for anything a real candidate will use.
#
# An API key from resend.com. Mail then leaves over HTTPS on 443, which matters:
# outbound SMTP is blocked on a great many networks in a way that looks like
# nothing at all — the connection is accepted and the server never answers.
RESEND_API_KEY=

# Who the invitation comes from, as a name and address:
#
#   Astrolabe <no-reply@your-domain.com>
#
# The domain has to be verified at resend.com/domains first. Until it is, the
# relay will only deliver to the account holder's own address — and an
# unverified sender is what a phishing message looks like to a mail provider,
# which is the difference between an inbox and a spam folder. In this product
# that difference is a candidate who does not sit: the link in the message is
# the only way in.
RESEND_FROM=

# Set to false once the two above are filled in.
MAILING_USE_NULL_SENDER=true


# --- required -------------------------------------------------------------

# SA password for the SQL Server container. SQL Server enforces its own policy and
# refuses to start if this is short or simple: at least 8 characters, with three of
# uppercase, lowercase, digits, symbols.
MSSQL_SA_PASSWORD=

# Signs the credential a candidate holds during an attempt. At least 32 characters.
# It is the only thing standing between a stranger and somebody else's exam, so it
# is per-environment and never shared with the pass phrase below.
EXAM_SESSION_SIGNING_KEY=

# ABP's string encryption pass phrase, which protects settings stored in the
# database. Changing it after data exists makes what it protected unreadable.
STRING_ENCRYPTION_PASSPHRASE=


# --- optional -------------------------------------------------------------

# Where the browser reaches each piece. The defaults match the ports published in
# docker-compose.yml. Change both together, and re-run the migrator afterwards:
# the SPA URL is also registered on the OpenIddict client as its redirect target.
#
# These must be loopback addresses while the stack runs over plain HTTP, because
# OpenIddict refuses a non-loopback redirect URI that is not HTTPS.
#SPA_PUBLIC_URL=http://localhost:8080
#API_PUBLIC_URL=http://localhost:8081

# Pass phrase for the OpenIddict signing/encryption certificate, if you supply one
# (see docs/deployment.md). Without a certificate the tokens issued by a container
# stop validating when that container restarts.
#OPENIDDICT_CERT_PASSPHRASE=
